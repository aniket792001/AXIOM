# ==============================================================================
# Axiom & SCORE Engine: Environment Configuration
# Copy this file to .env and configure your keys
# ==============================================================================

# Application & Runtime Environment
APP_ENV=development
APP_NAME=Axiom-RAG
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Primary Reasoning & Grading Models
# You can use Google Gemini (recommended for speed/cost) and/or OpenAI
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Fast Grading Model (used for routing, chunk relevance, and hallucination checks)
FAST_MODEL=gemini-flash-latest
# High Reasoning Model (used for final citation-grounded synthesis)
REASONING_MODEL=gemini-flash-latest

# Vector Database Configuration (Options: "qdrant", "chroma")
VECTOR_STORE_TYPE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=axiom_contracts

# Retrieval & Re-ranking Settings
EMBEDDING_MODEL=text-embedding-004
# or "text-embedding-3-small" for OpenAI
BM25_ENABLED=true
RERANKER_ENABLED=false
COHERE_API_KEY=your_cohere_api_key_here

# Live Web Search Fallback
TAVILY_API_KEY=your_tavily_api_key_here

# Agent Graph Thresholds
MAX_LOOP_COUNT=3
MIN_RELEVANCE_SCORE=0.7

# Observability & Tracing (LangSmith / Phoenix)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=axiom-production
